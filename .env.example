# Copy to .env to configure scripts/migration-readiness-check.sh.
# .env is gitignored -- never put real secrets in it; this script doesn't
# need any (it only reads local YAML files).

# Directory of Kubernetes manifests to audit.
MANIFEST_DIR=./scripts/fixtures

# When "true", the script exits non-zero if any issue is found (useful to
# gate a CI job). Default "false" just prints the report.
STRICT_MODE=false
